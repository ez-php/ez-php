# APP
APP_NAME=ez-php
APP_PORT=8001
APP_ENV=local
APP_DEBUG=true
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# APP_VERSION=1.0.0

# CACHE
REDIS_PORT=6383
CACHE_DRIVER=file
CACHE_PATH=/tmp/ez-cache
CACHE_REDIS_HOST=redis
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0
# CACHE_MEMCACHED_HOST=127.0.0.1
# CACHE_MEMCACHED_PORT=11211
# CACHE_MEMCACHED_WEIGHT=0

# DATABASE
DB_HOST=db
DB_PORT=3306
DB_HOST_PORT=3308
DB_DATABASE=ez-php
DB_USERNAME=ez-php
DB_PASSWORD=ez-php
DB_TESTING_DATABASE=ez-php_testing
# DB_DRIVER=mysql            # mysql | sqlite

# MAIL
MAIL_DRIVER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_WEB_PORT=8025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=none
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=ez-php
MAIL_LOG_PATH=
MAIL_TIMEOUT=30
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=
# MAILGUN_REGION=us
# SENDGRID_API_KEY=

# QUEUE
QUEUE_DRIVER=database
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_DB=0

# RATE LIMITER
RATE_LIMITER_DRIVER=array
RATE_LIMITER_REDIS_HOST=redis
RATE_LIMITER_REDIS_PORT=6379
RATE_LIMITER_REDIS_DB=0
# default: <sys temp dir>/ez-php-rate-limiter
# RATE_LIMITER_FILE_PATH=

# LOGGING
LOG_DRIVER=file
LOG_LEVEL=debug
LOG_PATH=
LOG_MAX_BYTES=0
LOG_JSON_INNER=stdout

# VIEW
VIEW_PATH=resources/views

# BROADCAST
BROADCAST_DRIVER=null
BROADCAST_LOG_PATH=
# BROADCAST_REDIS_HOST=127.0.0.1
# BROADCAST_REDIS_PORT=6379
# BROADCAST_REDIS_DB=0

# SEARCH
SEARCH_DRIVER=null
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=
# ELASTICSEARCH_HOST=http://elasticsearch:9200
# ELASTICSEARCH_USER=
# ELASTICSEARCH_PASSWORD=
# TYPESENSE_HOST=http://typesense:8108
# TYPESENSE_KEY=

# HEALTH
HEALTH_REDIS_HOST=redis
HEALTH_REDIS_PORT=6379
# HEALTH_OPCACHE_ENABLED=false

# FEATURE FLAGS
FLAGS_DRIVER=file
# Path to the flag definitions file, relative to the application root.
# Must not live in config/ — everything there is loaded as configuration,
# so the file driver would read its own config as the flag list.
FLAGS_FILE=flags.php
# FLAGS_REDIS_HOST=127.0.0.1
# FLAGS_REDIS_PORT=6379
# FLAGS_REDIS_DB=0

# ─────────────────────────────────────────────────────────────────────────────
# Optional modules — commented out; every value shown is the default the matching
# config/*.php file uses when the variable is unset. Uncomment what you use.
# ─────────────────────────────────────────────────────────────────────────────

# SESSION
# SESSION_DRIVER=file              # file | database | redis | array
# default: <sys temp dir>/ez-session
# SESSION_FILE_PATH=
# SESSION_TABLE=sessions
# SESSION_REDIS_HOST=127.0.0.1
# SESSION_REDIS_PORT=6379
# SESSION_REDIS_DATABASE=0
# SESSION_REDIS_TTL=1440
# SESSION_REGENERATE_INTERVAL=0    # seconds; 0 = never rotate the id on a timer
# SESSION_STRICT_MODE=true
# cookie name; empty = PHP default (PHPSESSID)
# SESSION_COOKIE=
# empty = secure when the request is HTTPS
# SESSION_SECURE_COOKIE=
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=Lax
# SESSION_LIFETIME=0               # cookie lifetime in seconds; 0 = until the browser closes
# SESSION_PATH=/
# SESSION_DOMAIN=

# STORAGE
# STORAGE_DRIVER=local             # local | s3 | gcs
# STORAGE_ROOT=
# STORAGE_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_URL=
# STORAGE_S3_URL_EXPIRY=3600
# STORAGE_S3_MULTIPART_PART_SIZE=8 # MiB
# GCS_BUCKET=
# GCS_ACCESS_TOKEN=
# GCS_URL=

# MEDIA
# MEDIA_DRIVER=gd                  # gd | imagick

# WEBHOOK
# WEBHOOK_SECRET=
# WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature
# WEBHOOK_QUEUE=default
# WEBHOOK_TIMESTAMPED=false
# WEBHOOK_TOLERANCE=0

# AI (OPENAI_* and GEMINI_API_KEY are shared with AI MEDIA)
# AI_DRIVER=null                   # null | openai | anthropic | gemini | mistral | grok | log
# AI_EMBEDDING_DRIVER=null         # null | openai | gemini
# AI_STREAM_IDLE_TIMEOUT=120
# AI_LOG_INNER_DRIVER=null
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_VERSION=2023-06-01
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_BASE_URL=https://api.mistral.ai
# GROK_API_KEY=
# GROK_MODEL=grok-3-mini
# GROK_BASE_URL=https://api.x.ai

# AI MEDIA
# AI_MEDIA_IMAGE_DRIVER=null       # null | openai | gemini
# AI_MEDIA_TRANSCRIPTION_DRIVER=null
# AI_MEDIA_SPEECH_DRIVER=null
# AI_MEDIA_OPENAI_IMAGE_MODEL=dall-e-3
# AI_MEDIA_OPENAI_TRANSCRIPTION_MODEL=whisper-1
# AI_MEDIA_OPENAI_SPEECH_MODEL=tts-1
# AI_MEDIA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# AI_MEDIA_GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
# AI_MEDIA_GEMINI_TRANSCRIPTION_MODEL=gemini-2.0-flash
# AI_MEDIA_GEMINI_SPEECH_MODEL=gemini-2.5-flash-preview-tts

# PUSH
# PUSH_DRIVER=null                 # null | apns | fcm | webpush
# PUSH_APNS_PRIVATE_KEY=
# PUSH_APNS_KEY_ID=
# PUSH_APNS_TEAM_ID=
# PUSH_APNS_BUNDLE_ID=
# PUSH_APNS_SANDBOX=false
# PUSH_FCM_PRIVATE_KEY=
# PUSH_FCM_PROJECT_ID=
# PUSH_FCM_CLIENT_EMAIL=
# PUSH_WEBPUSH_PRIVATE_KEY=
# PUSH_WEBPUSH_SUBJECT=
# PUSH_WEBPUSH_TTL=86400

# GRAPHQL
# GRAPHQL_ENDPOINT=/graphql
# GRAPHQL_MAX_QUERY_DEPTH=15
# GRAPHQL_MAX_QUERY_COMPLEXITY=200
# GRAPHQL_PERSISTED_QUERIES=false
# GRAPHQL_PERSISTED_QUERIES_TTL=0  # seconds; 0 = keep forever

# OPENAPI
# OPENAPI_ENDPOINT=/openapi.json


# OTEL
# empty = no export
# OTEL_EXPORTER=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=ez-php-app
